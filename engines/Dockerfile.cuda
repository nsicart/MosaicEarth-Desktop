ARG CUDA_BUILD=mosaicearth-opensplat:1.2.2-cuda-candidate
FROM ${CUDA_BUILD}

ARG CUDA_ARCHITECTURES=61
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]
WORKDIR /code
RUN source .github/workflows/cuda/Linux-env.sh cu118 \
    && cmake -S /code -B /tmp/desktop-cuda -GNinja -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_PREFIX_PATH=/code/libtorch -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
       -DCUDA_TOOLKIT_ROOT_DIR="$CUDA_HOME" \
    && ninja -C /tmp/desktop-cuda -j2 \
    && install -D /tmp/desktop-cuda/opensplat /opt/opensplat/bin/opensplat \
    && install -D LICENSE.txt /opt/opensplat/LICENSE.txt \
    && rm -rf /tmp/desktop-cuda
RUN apt-get update && apt-get install -y --no-install-recommends colmap=3.7-2 \
    && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/code/libtorch/lib:/usr/local/cuda-11.8/lib64:/usr/local/nvidia/lib64 \
    QT_QPA_PLATFORM=offscreen OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
RUN /opt/opensplat/bin/opensplat --version
ENTRYPOINT []
