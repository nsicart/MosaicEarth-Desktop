name: iOS Bridge (SwiftUI + ShareExtension)

on:
  push:
    paths:
      - 'connectors/ios-bridge/**'
      - '.github/workflows/ios-bridge.yml'
  pull_request:
    paths:
      - 'connectors/ios-bridge/**'
      - '.github/workflows/ios-bridge.yml'
  workflow_dispatch:

jobs:
  build-and-test-ios-bridge:
    runs-on: macos-14
    defaults:
      run:
        working-directory: connectors/ios-bridge
    steps:
      - uses: actions/checkout@v4

      - name: Run Swift Package Unit Tests (MosaicEarthBridgeKit)
        run: swift test -v

      - name: Generate Xcode Project via XcodeGen
        run: |
          if ! command -v xcodegen >/dev/null 2>&1; then
            brew install xcodegen
          fi
          xcodegen generate

      - name: Build SwiftUI App + ShareExtension for iOS Simulator (Unsigned CI Check)
        run: |
          xcodebuild \
            -project MosaicEarthBridge.xcodeproj \
            -scheme MosaicEarthBridge \
            -sdk iphonesimulator \
            -destination 'generic/platform=iOS Simulator' \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            build
